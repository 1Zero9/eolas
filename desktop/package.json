{
  "name": "eolas-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Eolas Desktop — macOS menu bar indicator for ideas and accelerators.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.eolas.desktop",
    "productName": "Eolas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.env"
    ],
    "extraResources": [
      {
        "from": "../scripts",
        "to": "scripts"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dir"
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    }
  }
}
